{
  "name": "lder",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../frontend/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lder",
      "database_id": "82b514bb-5ed8-44af-9b17-ed4a90b735be",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "ASSISTANT_MODEL": "lder-assistant",
    "CLASSIFIER_MODEL": "lder-classifier",
    "CORS_ORIGINS": "",
    "ENABLE_SCHEDULER": "true",
    "FRONTEND_BASE_URL": "",
    "PUBLIC_BASE_URL": "",
    "STT_BASE_URL": "https://api.groq.com/openai/v1",
    "STT_MODEL": "whisper-large-v3",
    "SUMMARY_MODEL": "lder-summary"
  },
  "observability": { "enabled": true }
}
